{
  "manifest_version": 3,
  "name": "Tabboard",
  "version": "3.2",
  "description": "Your GitHub Projects tasks, PRs and notes on every new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/login/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tabboard: switch new tabs between Tabboard and Chrome (Alt+Shift+T)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Switch new tabs between Tabboard and Chrome"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
